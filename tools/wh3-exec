#!/bin/bash
# wh3-exec: push a Lua snippet into a RUNNING Total War: Warhammer 3 campaign
# (or battle with -b) and wait for the result. The in-game mod executes it live
# via its exec bridge — no restart, no UI interaction.
#
# Requirements:
#   - The game is running with wh3_mcp.pack enabled (campaign loaded)
#   - An SSH alias exists for the Windows machine (edit VM_SSH_ALIAS below)
#   - The mod's OUTPUT_DIR exists on the PC (default C:\wh3-mcp-data)
#
# Usage:
#   wh3-exec 'cm:grant_money("wh3_main_ksl_the_ice_court", 10000)'
#   wh3-exec -b 'bm:... your battle lua ...'
#   wh3-exec -f /path/to/script.lua
#
# Result: prints exec_result.json {ok, error, output, result, request, timestamp}
set -e

VM_SSH_ALIAS="${WH3_VM:-wh3-pc}"            # ~/.ssh/config Host entry
EXEC_DIR='C:/wh3-mcp-data/exec'             # must match mod OUTPUT_DIR
SSH_KEY="${WH3_SSH_KEY:-}"                  # optional -i flag if not in ssh config
DEADLINE="${WH3_EXEC_TIMEOUT:-45}"          # seconds to wait for in-game result

ssh_extra=(-o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=5)
[ -n "$SSH_KEY" ] && ssh_extra+=(-i "$SSH_KEY")

# Private per-invocation working dir (no symlink/stale-file attacks)
WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/wh3-exec.XXXXXX")
trap 'rm -rf "$WORKDIR"' EXIT

BATTLE=0
if [ "$1" = "-b" ]; then
  BATTLE=1
  shift
fi

if [ "$BATTLE" = "1" ]; then
  SCRIPT_REMOTE='exec_battle_script.lua'
  TRIGGER_REMOTE='exec_battle_trigger.txt'
  RESULT_REMOTE='exec_battle_result.json'
  echo "battle mode"
else
  SCRIPT_REMOTE='exec_script.lua'
  TRIGGER_REMOTE='exec_trigger.txt'
  RESULT_REMOTE='exec_result.json'
fi

SCRIPT="$WORKDIR/$SCRIPT_REMOTE"
TRIGGER="$WORKDIR/$TRIGGER_REMOTE"
RESULT="$WORKDIR/$RESULT_REMOTE"

if [ "$1" = "-f" ]; then
  cp "$2" "$SCRIPT"
else
  printf '%s' "$1" > "$SCRIPT"
fi

# Monotonic trigger: seed from the remote watermark (also handles multi-client)
REMOTE_WM=$(ssh "${ssh_extra[@]}" "$VM_SSH_ALIAS" "type $EXEC_DIR\\$TRIGGER_REMOTE 2>nul || echo 0" 2>/dev/null | tr -d '\r' | tail -1)
case "$REMOTE_WM" in
  ''|*[!0-9]*) REMOTE_WM=0 ;;
esac
REMOTE_WM=$(( REMOTE_WM + 0 ))
NOW=$(date +%s)
NEXT=$(( REMOTE_WM > NOW ? REMOTE_WM + 1 : NOW ))
printf '%s' "$NEXT" > "$TRIGGER"

echo "Pushing $SCRIPT_REMOTE ($(wc -c < "$SCRIPT") bytes, request $NEXT)..."
scp "${ssh_extra[@]}" "$SCRIPT" "$VM_SSH_ALIAS:$EXEC_DIR/$SCRIPT_REMOTE" >/dev/null
scp "${ssh_extra[@]}" "$TRIGGER" "$VM_SSH_ALIAS:$EXEC_DIR/$TRIGGER_REMOTE" >/dev/null

echo "Waiting for in-game execution (up to ${DEADLINE}s)..."
START=$(date +%s)
while true; do
  NOW=$(date +%s)
  if [ $((NOW - START)) -ge "$DEADLINE" ]; then
    echo "TIMED OUT — is the campaign running with wh3_mcp.pack enabled?"
    exit 1
  fi
  if scp "${ssh_extra[@]}" "$VM_SSH_ALIAS:$EXEC_DIR/$RESULT_REMOTE" "$RESULT" >/dev/null 2>&1 && [ -s "$RESULT" ]; then
    REQ=$(python3 -c "import json,sys
try:
    d=json.load(open('$RESULT'))
    print(d.get('request'))
except Exception:
    print('')" 2>/dev/null)
    if [ "$REQ" = "$NEXT" ]; then
      echo "=== $RESULT_REMOTE:"
      python3 -c "
import json, sys
d = json.load(open('$RESULT'))
print('ok:', d.get('ok'))
if d.get('error'): print('error:', d.get('error'))
if d.get('output'): print('output:'); print(d['output'])
if d.get('result') is not None: print('result:', d['result'])
sys.exit(0 if d.get('ok') else 2)
"
      exit $?
    fi
  fi
  sleep 1
done
